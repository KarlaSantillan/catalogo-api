# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# Servidor
PORT=3000

# Conexión a PostgreSQL (puedes usar DATABASE_URL o las variables separadas)
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/catalogo_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=catalogo_db
PGUSER=
PGPASSWORD=

# JWT: usa una cadena larga y aleatoria (mínimo 32 caracteres)
# Puedes generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Datos del administrador inicial (los usa: npm run crear-admin)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@catalogo.local
ADMIN_PASSWORD=
